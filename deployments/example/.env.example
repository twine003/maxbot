# Copy this file to `.env` (the installer does it for you) and fill in the token.
# .env is git-ignored — your secrets never get committed.

# The ONLY thing you must set before first start. From @BotFather on Telegram:
TELEGRAM_BOT_TOKEN=

# ALLOWED_CHAT_IDS is configured automatically the first time you pair the bot
# (send the pairing code shown in the server console). You normally leave it
# blank. To pre-authorize chats manually instead, set them comma-separated:
# ALLOWED_CHAT_IDS=111111111,222222222

# Agent credentials (ANTHROPIC_API_KEY / OPENAI_API_KEY) are written here
# automatically by the in-Telegram setup wizard. You can also set them by hand.

# Optional overrides
# CLAUDE_TIMEOUT=300
