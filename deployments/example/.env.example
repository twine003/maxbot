# Copy this file to `.env` (the installer does it for you) and fill in.
# .env is git-ignored — your token never gets committed.

# From @BotFather on Telegram:
TELEGRAM_BOT_TOKEN=

# Your numeric Telegram chat id (talk to @userinfobot to get it).
# Comma-separated for multiple allowed chats: 111111111,222222222
ALLOWED_CHAT_IDS=

# Optional overrides
# CLAUDE_TIMEOUT=300
